set number "Menampilkan nomor baris disebelah kiri
set tabstop=4 "ukuran 1 tab setara 4 spasi
set shiftwidth=4 "ukuran geser indentasi 4 spasi
set expandtab "ubah tombol tab jadi spasi
set autoindent "indentasi otomatis pada baris baru
set hlsearch "sorot warna hasil pencarian
syntax on "aktifkan warna sintaks kode
